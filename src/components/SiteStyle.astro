---
---
<style is:inline>
    body {
        background-color: #dddddd; /* 背景：明るい灰色 */
        color: #000000;
        font-family: "MS Pゴシック", "MS PGothic", "Meiryo", sans-serif;
        font-size: 14px;
        margin: 0;
        padding: 15px;
        line-height: 1.6;
    }

    .outer-frame {
        background-color: #f4f4f4;
        border: 1px solid #888888;
        max-width: 1000px;
        margin: 0 auto;
        padding: 1px;
    }

    .site-header {
        background-color: #000080;
        color: #ffffff;
        padding: 8px 15px;
        font-size: 16px;
        font-weight: bold;
        border: 1px inset #000040;
    }

    .layout-table {
        width: 100%;
        border-collapse: collapse;
    }

    .sidebar {
        width: 180px;
        vertical-align: top;
        padding: 20px 15px;
        font-size: 12px;
        border-right: 1px solid #cccccc;
        line-height: 1.8;
        background-color: #f4f4f4;
    }

    .main-content {
        vertical-align: top;
        padding: 25px;
        background-color: #ffffff;
    }

    /* 投稿・辞書用の共通枠 */
    .post-container {
        margin-bottom: 30px;
        border: 1px solid #000080;
        background-color: #ffffff;
    }

    .post-header {
        background-color: #000080;
        color: #ffffff;
        padding: 4px 10px;
        font-weight: bold;
        font-size: 12px;
    }

    .post-body {
        padding: 15px;
    }

    a {
        color: #0000ff;
        text-decoration: underline;
    }
    a:visited {
        color: #800080;
    }
    a:hover {
        background-color: #0000ff;
        color: #ffffff;
    }

    .banner-space {
        margin: 5px 0;
        border: 1px inset #cccccc;
        width: 88px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        font-size: 10px;
        color: #666;
    }
</style>
