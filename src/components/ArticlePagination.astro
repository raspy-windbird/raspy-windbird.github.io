---
/**
 * ブログ記事のペジネーション/シリーズナビゲーションコンポーネント
 * 上部と下部に配置可能
 */

import type { PaginationData } from "../types";

interface Props {
    paginationData: PaginationData;
    position?: "top" | "bottom"; // デフォルトは top
}

const { paginationData, position = "top" } = Astro.props;

// シリーズか分割記事か判定（これは親ページから groupType を受け取るとより良い）
// 今回は記事スラッグのパターンから推測
const isMultiPage = paginationData.totalCount > 1;

// ページ番号リストを生成
const pageList = paginationData.all.map((post, idx) => ({
    number: idx + 1,
    slug: post.slug,
    isActive: post.slug === paginationData.current.slug,
}));
---

<nav class={`article-pagination pagination-${position}`}>
    <div class="pagination-info">
        {
            isMultiPage ? (
                <div class="multi-page-info">
                    ページ: <strong>{paginationData.currentIndex}</strong> /{" "}
                    <strong>{paginationData.totalCount}</strong>
                </div>
            ) : (
                <div class="series-info">
                    第<strong>{paginationData.currentIndex}</strong>回 / 全
                    <strong>{paginationData.totalCount}</strong>回
                </div>
            )
        }
    </div>

    <div class="pagination-nav">
        <!-- 前へリンク -->
        {
            paginationData.prev ? (
                <a
                    href={`/blog/${paginationData.prev.slug}`}
                    class="nav-link prev-link"
                >
                    ← 前へ
                </a>
            ) : (
                <span class="nav-link prev-link disabled">← 前へ</span>
            )
        }

        <!-- ページ番号リスト -->
        {
            isMultiPage && (
                <div class="page-numbers">
                    {pageList.map((page, idx) => (
                        <>
                            {page.isActive ? (
                                <strong class="page-number active">
                                    {page.number}
                                </strong>
                            ) : (
                                <a
                                    href={`/blog/${page.slug}`}
                                    class="page-number"
                                >
                                    {page.number}
                                </a>
                            )}
                            {idx < pageList.length - 1 && (
                                <span class="separator">|</span>
                            )}
                        </>
                    ))}
                </div>
            )
        }

        <!-- 次へリンク -->
        {
            paginationData.next ? (
                <a
                    href={`/blog/${paginationData.next.slug}`}
                    class="nav-link next-link"
                >
                    次へ →
                </a>
            ) : (
                <span class="nav-link next-link disabled">次へ →</span>
            )
        }
    </div>
</nav>

<style is:inline>
    /* 控えめなスタイル：目立たない小さなナビゲーション */
    .article-pagination {
        margin: 12px 0;
        padding: 6px 8px;
        border: none;
        background-color: transparent;
        font-size: 12px;
        color: #444444;
    }

    .pagination-top {
        margin-top: 0;
        border-bottom: none;
    }

    .pagination-bottom {
        margin-bottom: 0;
        border-top: none;
    }

    .pagination-info {
        margin-bottom: 6px;
        text-align: center;
        font-weight: normal;
        color: #666666;
        font-family: monospace;
        font-size: 11px;
    }

    .multi-page-info,
    .series-info {
        display: inline-block;
    }

    .pagination-nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .nav-link {
        padding: 2px 6px;
        color: #3333aa;
        text-decoration: none;
        cursor: pointer;
        font-weight: normal;
        border-radius: 2px;
    }

    .nav-link:hover {
        background-color: #fffff5;
        color: #3333aa;
    }

    .nav-link.disabled {
        color: #cccccc;
        text-decoration: none;
        cursor: not-allowed;
    }

    .page-numbers {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .page-number {
        padding: 1px 4px;
        color: #3333aa;
        cursor: pointer;
        text-decoration: none;
        font-size: 11px;
    }

    .page-number:hover {
        background-color: transparent;
    }

    .page-number.active {
        padding: 1px 4px;
        background-color: transparent;
        color: #333333;
        text-decoration: underline;
        font-weight: normal;
    }

    .separator {
        color: #bbbbbb;
        margin: 0 3px;
    }
</style>
