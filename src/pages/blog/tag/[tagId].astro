---
import Layout from "../../../layouts/Layout.astro";
import { getPostsByTag, getAllTags } from "../../../utils/series";

/**
 * タグ別記事表示ページ
 * URL: /blog/tag/[tagId]
 */

export async function getStaticPaths() {
    const tags = await getAllTags();
    return tags.map((tag) => ({
        params: { tagId: tag },
        props: { tag },
    }));
}

const { tag } = Astro.props;
const posts = await getPostsByTag(tag);
---

<Layout title={`タグ: ${tag}`}>
    <div class="post-container">
        <div class="post-header">タグ: <span class="tag-name">{tag}</span></div>
        <div class="post-body">
            {
                posts.length === 0 ? (
                    <p>このタグが付いた記事はありません</p>
                ) : (
                    <>
                        <p class="tag-count">{posts.length} 件の記事</p>
                        <ul class="tag-list">
                            {posts.map((post) => (
                                <li class="tag-item">
                                    <a
                                        href={`/blog/${post.slug}`}
                                        class="tag-item-title"
                                    >
                                        {post.data.title}
                                    </a>
                                    <span class="tag-item-date">
                                        {post.data.date.toLocaleDateString(
                                            "ja-JP",
                                            {
                                                year: "numeric",
                                                month: "2-digit",
                                                day: "2-digit",
                                            },
                                        )}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    </>
                )
            }
        </div>
    </div>

    <p><a href="/blog">[ブログ一覧に戻る]</a></p>
</Layout>

<style is:inline>
    .tag-name {
        background-color: #000080;
        color: #ffffff;
        padding: 4px 8px;
        border-radius: 3px;
        font-weight: bold;
    }

    .tag-count {
        font-size: 12px;
        color: #666666;
        margin-bottom: 15px;
    }

    .tag-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .tag-item {
        border-bottom: 1px solid #cccccc;
        padding: 12px 0;
        margin-bottom: 8px;
    }

    .tag-item:last-child {
        border-bottom: none;
    }

    .tag-item-title {
        display: block;
        font-weight: bold;
        color: #0000ff;
        text-decoration: underline;
        margin-bottom: 5px;
    }

    .tag-item-title:hover {
        background-color: #ffffee;
    }

    .tag-item-date {
        font-size: 11px;
        color: #999999;
        font-family: monospace;
    }
</style>
