---
import Layout from "../../layouts/Layout.astro";
import {
    getAllBlogPosts,
    getAllGroups,
    getPostsByMonth,
    getAllTags,
    getPostsByTag,
} from "../../utils/series";

/**
 * ブログ一覧ページ
 * URL: /blog
 *
 * シリーズもの: 1つのグループにまとめて表示
 * その他: 月別にアーカイブ表示
 */

const posts = await getAllBlogPosts();
const groups = await getAllGroups();
const monthlyPosts = await getPostsByMonth();

// 連載シリーズのみ抽出（series のみ一覧にまとめる）
const seriesGroups = groups.filter((g) => g.type === "series");

// 単独記事（月別）: groupId を持たない記事、または groupType が multi-page の記事を単発扱いにする
const standaloneMonthly = monthlyPosts
    .map((monthData) => ({
        ...monthData,
        posts: monthData.posts.filter(
            (post) =>
                !post.data.groupId || post.data.groupType === "multi-page",
        ),
    }))
    .filter((monthData) => monthData.posts.length > 0);

// タグ一覧データ（/blog/ 上で表示するため）
const tags = await getAllTags();
const tagData = await Promise.all(
    tags.map(async (tag) => ({
        tag,
        count: (await getPostsByTag(tag)).length,
    })),
);
---

<Layout title="ブログ一覧">
    <div class="post-container">
        <div class="post-header">ブログ一覧</div>
        <div class="post-body">
            {
                posts.length === 0 ? (
                    <p>記事がまだありません</p>
                ) : (
                    <>
                        {/* シリーズグループ */}
                        {seriesGroups.length > 0 && (
                            <div class="series-section">
                                <h2 class="series-heading">連載シリーズ</h2>
                                <ul class="series-list">
                                    {seriesGroups.map((group) => (
                                        <li class="series-item">
                                            <div class="series-header">
                                                <span class="series-title">
                                                    {group.title}
                                                </span>
                                                <span class="series-count">
                                                    全 {group.posts.length}
                                                    {group.type === "series"
                                                        ? "回"
                                                        : "ページ"}
                                                </span>
                                            </div>
                                            <ul class="series-parts">
                                                {group.posts.map(
                                                    (post, idx) => (
                                                        <li class="series-part">
                                                            <a
                                                                href={`/blog/${post.slug}`}
                                                                class="series-link"
                                                            >
                                                                {group.type ===
                                                                "series"
                                                                    ? `第${
                                                                          idx +
                                                                          1
                                                                      }回`
                                                                    : `ページ ${
                                                                          idx +
                                                                          1
                                                                      }`}
                                                                :{" "}
                                                                {
                                                                    post.data
                                                                        .title
                                                                }
                                                            </a>
                                                        </li>
                                                    ),
                                                )}
                                            </ul>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}

                        {/* タグ一覧セクション（/blog/#tags へリダイレクトと一致） */}
                        {tagData.length > 0 && (
                            <div id="tags" class="tags-section">
                                <h2 class="tags-heading">タグ一覧</h2>
                                <ul class="tags-list">
                                    {tagData.map((t) => (
                                        <li class="tags-item">
                                            <a
                                                href={`/blog/tag/${t.tag}`}
                                                class="tag-link"
                                            >
                                                #{t.tag}
                                            </a>
                                            <span class="tag-count">
                                                ({t.count})
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}

                        {/* 単独記事（月別） */}
                        {standaloneMonthly.length > 0 && (
                            <div class="monthly-section">
                                {groups.length > 0 && (
                                    <h2 class="monthly-heading">アーカイブ</h2>
                                )}
                                {standaloneMonthly.map((monthData) => (
                                    <div class="monthly-group">
                                        <h3 class="monthly-title">
                                            {monthData.month}
                                            <span class="monthly-count">
                                                ({monthData.count}件)
                                            </span>
                                        </h3>
                                        <ul class="blog-list">
                                            {monthData.posts.map((post) => (
                                                <li class="blog-item">
                                                    <a
                                                        href={`/blog/${post.slug}`}
                                                        class="blog-title"
                                                    >
                                                        {post.data.title}
                                                    </a>
                                                    <span class="blog-date">
                                                        {post.data.date.toLocaleDateString(
                                                            "ja-JP",
                                                            {
                                                                year: "numeric",
                                                                month: "2-digit",
                                                                day: "2-digit",
                                                            },
                                                        )}
                                                    </span>

                                                    {post.data.tags &&
                                                        post.data.tags.length >
                                                            0 && (
                                                            <div class="blog-tags">
                                                                {post.data.tags.map(
                                                                    (tag) => (
                                                                        <a
                                                                            href={`/blog/tag/${tag}`}
                                                                            class="tag-link"
                                                                        >
                                                                            #
                                                                            {
                                                                                tag
                                                                            }
                                                                        </a>
                                                                    ),
                                                                )}
                                                            </div>
                                                        )}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ))}
                            </div>
                        )}
                    </>
                )
            }
        </div>
    </div>

    <p><a href="/">[トップに戻る]</a></p>
</Layout>

<style is:inline>
    .blog-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .blog-item {
        border-bottom: 1px solid #cccccc;
        padding: 15px 0;
        margin-bottom: 10px;
    }

    .blog-item:last-child {
        border-bottom: none;
    }

    .blog-title {
        display: block;
        font-size: 16px;
        font-weight: bold;
        color: #0000ff;
        text-decoration: underline;
        margin-bottom: 5px;
    }

    .blog-title:hover {
        background-color: #ffffee;
    }

    .blog-date {
        font-size: 12px;
        color: #666666;
        font-family: monospace;
        display: inline-block;
        margin-right: 15px;
    }

    .blog-tags {
        font-size: 11px;
    }

    .tag-link {
        display: inline-block;
        margin-right: 8px;
        color: #0000ff;
        text-decoration: underline;
    }

    .tag-link:hover {
        background-color: #0000ff;
        color: #ffffff;
    }

    /* シリーズセクションのスタイル */
    .series-section {
        margin-bottom: 30px;
    }

    .series-heading {
        font-size: 18px;
        font-weight: bold;
        color: #000080;
        border-bottom: 2px solid #000080;
        padding-bottom: 8px;
        margin-bottom: 15px;
        background-color: #f4f4f4;
        padding: 8px;
    }

    .series-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .series-item {
        border: 1px solid #cccccc;
        background-color: #fafafa;
        padding: 15px;
        margin-bottom: 15px;
    }

    .series-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .series-title {
        font-size: 16px;
        font-weight: bold;
        color: #0000ff;
    }

    .series-count {
        font-size: 13px;
        color: #666666;
        background-color: #ffffee;
        padding: 3px 8px;
        border-radius: 3px;
    }

    .series-parts {
        list-style: none;
        padding-left: 10px;
        margin: 0;
    }

    .series-part {
        font-size: 13px;
        padding: 5px 0;
        border-left: 2px solid #cccccc;
        padding-left: 10px;
        margin-left: 0;
    }

    .series-link {
        color: #0000ff;
        text-decoration: none;
    }

    .series-link:hover {
        text-decoration: underline;
        background-color: #ffffee;
    }

    /* 月別アーカイブのスタイル */
    .monthly-section {
        margin-bottom: 20px;
    }

    .monthly-heading {
        font-size: 18px;
        font-weight: bold;
        color: #000080;
        border-bottom: 2px solid #000080;
        padding-bottom: 8px;
        margin-bottom: 15px;
        background-color: #f4f4f4;
        padding: 8px;
    }

    .monthly-group {
        margin-bottom: 25px;
    }

    .monthly-title {
        font-size: 15px;
        font-weight: bold;
        color: #000080;
        border-left: 4px solid #000080;
        padding-left: 10px;
        margin: 15px 0 10px 0;
        background-color: #f4f4f4;
        padding: 5px 8px;
    }

    .monthly-count {
        font-size: 12px;
        color: #666666;
        font-weight: normal;
    }

    /* タグ一覧スタイル */
    .tags-section {
        margin: 20px 0;
    }

    .tags-heading {
        font-size: 18px;
        font-weight: bold;
        color: #000080;
        border-bottom: 2px solid #000080;
        padding-bottom: 8px;
        margin-bottom: 12px;
        background-color: #f4f4f4;
        padding: 8px;
    }

    .tags-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
    }

    .tags-item {
        font-size: 13px;
    }

    .tag-count {
        color: #666666;
        margin-left: 6px;
        font-size: 12px;
    }
</style>
