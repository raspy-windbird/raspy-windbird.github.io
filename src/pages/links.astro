---
import Layout from "../layouts/Layout.astro";
import PostTitle from "../components/PostTitle.astro";

// 勝手連リスト（データが増えたらcontent/に移行してもヨシ！）
const favorites = [
    {
        name: "KENT WEB",
        url: "https://www.kent-web.com",
        note: "このサイトの設計思想の源流。CGIスクリプトの金字塔。",
    },
    {
        name: "しぐれうい公式 (YouTube)",
        url: "https://www.youtube.com/channel/UCt30jJgChL8qeT9VPadidSw",
        note: "最重要。神。",
    },
];
---

<Layout title="リンク集">
    <PostTitle title="a">
        <table class="link-table">
            {
                favorites.map((link) => (
                    <tr>
                        <th>
                            <a href={link.url} target="_blank" rel="noopener">
                                {link.name}
                            </a>
                        </th>
                        <td>{link.note}</td>
                    </tr>
                ))
            }
        </table>
        <div style="font-size: 10px; color: #666; padding: 10px;">
            ※勝手にリンクさせていただいております。不都合あればご連絡ください。
        </div>
    </PostTitle>
</Layout>

<style is:inline>
    .about-links {
        font-size: 13px;
        line-height: 1.6;
    }
    .my-banner-area {
        margin: 10px 0;
        padding: 10px;
        border: 1px inset #ccc;
        background: #eee;
        display: inline-block;
    }
    .link-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .link-table th {
        width: 180px;
        background-color: #f4f4f4;
        border: 1px solid #ccc;
        padding: 8px;
        text-align: left;
    }
    .link-table td {
        border: 1px solid #ccc;
        padding: 8px;
    }
    .link-table tr:hover {
        background-color: #ffffee;
    }
</style>
