---
import Layout from "../layouts/Layout.astro";
import PostBox from "../components/PostBox.astro";
---

<Layout title="自己紹介">
    <PostBox title="管理者">
        <table class="profile-table">
            <tr>
                <th>好物</th>
                <td>Raspberry Pi</td>
            </tr>
        </table>
    </PostBox>

    <PostBox title="管理人より">
        <div class="about-text">
            <p>ようこそ。</p>
            <p>
                モダンなWebの喧騒から離れ、1バイト削ることに命を懸けています。
            </p>
        </div>
    </PostBox>
</Layout>

<style is:inline>
    .profile-table {
        width: 100%;
        border-collapse: collapse;
    }
    .profile-table th {
        width: 150px;
        background-color: #000080;
        color: #ffffff;
        border: 1px solid #aaaaaa;
        padding: 5px;
        text-align: left;
    }
    .profile-table td {
        border: 1px solid #aaaaaa;
        padding: 8px;
    }
    .about-text p {
        margin-bottom: 1.2em;
        line-height: 1.8;
    }
</style>
