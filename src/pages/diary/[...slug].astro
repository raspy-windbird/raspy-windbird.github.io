---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// 全ての日記データを取得し、それぞれのパス(slug)をURLとして割り当てる
export async function getStaticPaths() {
    const diaryEntries = await getCollection("diary");
    return diaryEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const dateStr = entry.data.date.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
});
---

<Layout title={`${dateStr} ${entry.data.title}`}>
    <div class="post-container">
        <div class="post-header">
            {dateStr} ： {entry.data.title}
        </div>
        <div class="post-body">
            <div class="diary-content">
                <Content />
            </div>
        </div>
    </div>

    <p><a href="/diary">≪ 一覧へ戻る</a></p>
</Layout>

<style is:inline>
    /* 日記本文内の細かいスタイル調整 */
    .diary-content p {
        margin-bottom: 1em;
    }
    .diary-content img {
        border: 1px solid #000;
        max-width: 100%;
    }
</style>
