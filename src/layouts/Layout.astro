---
import SiteStyle from "../components/SiteStyle.astro";
import Hcard from "../components/HCard.astro";

interface Props {
    title: string;
}
const { title } = Astro.props;

const siteName = "かめそら";

const fullTitle = title === siteName ? siteName : `${title} - ${siteName}`;
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{fullTitle}</title>
        <SiteStyle />
    </head>
    <body>
        <div id="top" class="outer-frame">
            <div class="site-header">かめそらの庭</div>

            <table class="layout-table">
                <tr>
                    <td class="sidebar">
                        <b>[MENU]</b><br />
                        ・<a href="/">TOPページ</a><br />
                        <br />
                        ・<a href="/blog">ブログ</a><br />
                        ・<a href="/diary">雑記</a><br />
                        <br />
                        ・<a href="/dictionary">辞書</a><br />
                        ・<a href="/links">リンク集</a><br />
                        ・<a href="/about">このサイトについて</a><br />
                        <br /><br />
                        <Hcard />
                        <div class="banner-space">MyBanner</div>
                    </td>

                    <td class="main-content">
                        <slot />
                    </td>
                </tr>
            </table>

            <div
                style="border-top: 1px solid #888; padding: 15px; text-align: center; font-size: 11px; background: #F4F4F4;"
            >
                Copyright (C) 2025 Kamesora. All Rights Reserved.
            </div>
        </div>
    </body>
</html>
